# Copy to .env.local and fill in. Never commit the real file.

# Nullifier seed FIXED by this office (server-only; never read from the client).
# Any integer below the BN254 field size. Generate one with:
#   node -e "console.log(BigInt('0x'+require('crypto').randomBytes(16).toString('hex')).toString())"
# Changing it changes every applicant's nullifier, so keep it stable for the life of the office.
NULLIFIER_SEED=replace-with-a-random-integer

# Applicants must prove (revealed from the proof) that they are 18+ and live in this state.
# The SDK's test QR data lives in "Delhi".
ELIGIBLE_STATE=Delhi

# true  = accept proofs over the SDK's TEST Aadhaar key (demo / hackathon)
# false = accept only QRs signed by UIDAI's production key
USE_TEST_AADHAAR=true

# Reject QR codes whose signature timestamp is older than this many seconds (0 disables).
QR_MAX_AGE_SECONDS=3600

# Volunteer dashboard password (checked server-side, then an httpOnly session cookie is set).
VOLUNTEER_PASSWORD=replace-with-a-long-random-passphrase

# Secret used to sign the volunteer session cookie (32+ random chars).
SESSION_SECRET=replace-with-32-plus-random-characters

# SQLite file (created on first run). Kept out of git by .gitignore.
DATABASE_PATH=./data/one-claim.db
